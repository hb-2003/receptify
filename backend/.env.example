# =============================================================================
# Receptify Backend - Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
# DO NOT commit the '.env' file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Django Core Configuration
# -----------------------------------------------------------------------------
# Standard Django secret key. Change this to a secure random string for production.
SECRET_KEY=django-insecure-o9#@l3vh%@(o(qyt@3gr%x@b49@$162hj99m4$9yr!hf5xd!a=

# Key used for signing and verifying JWT authentication tokens.
JWT_SECRET=change_me

# -----------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
DB_NAME=receptify
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# -----------------------------------------------------------------------------
# 3. Cryptography & Security
# -----------------------------------------------------------------------------
# Secret 32-byte AES key used to encrypt and decrypt sensitive Twilio Credentials.
# For local dev fallback, this is padded/sliced to 32 bytes automatically.
ENCRYPTION_KEY=your_base64_encryption_key_here

# -----------------------------------------------------------------------------
# 4. Networking & Webhooks
# -----------------------------------------------------------------------------
# The public-facing HTTPS domain URL of your backend. Used by Twilio to send callbacks.
PUBLIC_APP_URL=https://api.receptify.in

# The public-facing HTTP/HTTPS domain URL of your frontend.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 5. Third-Party API Integrations
# -----------------------------------------------------------------------------
# API key for the Emergent LLM execution engine.
EMERGENT_LLM_KEY=your_emergent_llm_key_here

# -----------------------------------------------------------------------------
# 6. Email Configuration (Resend)
# -----------------------------------------------------------------------------
# Set this to use the Resend email backend. If empty, falls back to console backend in dev.
RESEND_API_KEY=your_resend_api_key_here
DEFAULT_FROM_EMAIL=onboarding@receptify.in
